# ===============================================================
# IntelliTrace Frontend Environment Configuration Template
# Copy this file to .env and fill in your actual values
# ===============================================================

# 🚀 API CONFIGURATION
VITE_API_BASE_URL=http://localhost:8000
VITE_API_VERSION=v1
VITE_API_TIMEOUT=30000

# 🔐 AUTHENTICATION
VITE_AUTH_ENABLED=true
VITE_JWT_LOCAL_STORAGE_KEY=intellitrace_token
VITE_JWT_EXPIRATION_BUFFER=300

# 📊 DASHBOARD CONFIGURATION
VITE_DASHBOARD_REFRESH_INTERVAL=5000
VITE_DASHBOARD_DEFAULT_TIME_RANGE=24h
VITE_DASHBOARD_AUTO_REFRESH=true

# 🌐 GRAPHING & VISUALIZATION
VITE_CYTOSCAPE_PHYSICS_ENABLED=true
VITE_CYTOSCAPE_PHYSICS_DAMPING=0.5
VITE_SANKEY_WIDTH=800
VITE_SANKEY_HEIGHT=600
VITE_D3_ANIMATION_DURATION=1000

# 🎨 UI/UX CONFIGURATION
VITE_THEME_MODE=dark
VITE_ANIMATIONS_ENABLED=true
VITE_SIDEBAR_COLLAPSIBLE=true
VITE_NOTIFICATION_POSITION=bottom-right
VITE_TOAST_DURATION=5000

# 📱 RESPONSIVE DESIGN
VITE_MOBILE_BREAKPOINT=768
VITE_TABLET_BREAKPOINT=1024
VITE_DESKTOP_BREAKPOINT=1440

# 🔔 REAL-TIME NOTIFICATIONS
VITE_WEBSOCKET_URL=ws://localhost:8000/ws
VITE_WEBSOCKET_RECONNECT_INTERVAL=3000
VITE_WEBSOCKET_MAX_RETRIES=5

# 📊 ANALYTICS & TRACKING
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ENDPOINT=https://analytics.intellitrace.ai
VITE_ERROR_TRACKING_ENABLED=false
VITE_ERROR_TRACKING_DSN=

# 🌍 LOCALIZATION
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,es,fr,de,zh,ja,hi
VITE_DEFAULT_TIMEZONE=UTC
VITE_DEFAULT_DATE_FORMAT=YYYY-MM-DD
VITE_DEFAULT_TIME_FORMAT=HH:mm:ss
VITE_DEFAULT_CURRENCY=USD

# 🛡️ SECURITY
VITE_ENABLE_CSP=true
VITE_ENABLE_SECURITY_HEADERS=true
VITE_SESSION_TIMEOUT=1800000
VITE_PASSWORD_MIN_LENGTH=8
VITE_ENABLE_TWO_FACTOR=true

# 🎯 FEATURE FLAGS
VITE_FEATURE_ANOMALY_DASHBOARD=true
VITE_FEATURE_NETWORK_GRAPH=true
VITE_FEATURE_RISK_SCORING=true
VITE_FEATURE_NARRATIVE_VIEW=false
VITE_FEATURE_EXPORT_REPORTS=true
VITE_FEATURE_BULK_ACTIONS=true
VITE_FEATURE_ADVANCED_FILTERS=true
VITE_FEATURE_CUSTOM_ALERTS=true

# 📈 PERFORMANCE
VITE_LAZY_LOADING_ENABLED=true
VITE_CODE_SPLITTING_ENABLED=true
VITE_ASSET_COMPRESSION=true
VITE_IMAGE_OPTIMIZATION=true
VITE_MAX_BUNDLE_SIZE=1000

# 🔄 CACHING
VITE_CACHE_CONTROL_MAX_AGE=3600
VITE_SERVICE_WORKER_ENABLED=true
VITE_PERSIST_STATE=true
VITE_PERSIST_STORAGE=localStorage

# 📋 PAGINATION & TABLES
VITE_ITEMS_PER_PAGE=20
VITE_MAX_ITEMS_PER_PAGE=100
VITE_TABLE_VIRTUAL_SCROLLING=true

# 🎓 TUTORIALS & HELP
VITE_SHOW_TUTORIALS=true
VITE_HELP_CENTER_URL=https://help.intellitrace.ai
VITE_DOCUMENTATION_URL=https://docs.intellitrace.ai
VITE_SUPPORT_EMAIL=support@intellitrace.ai

# 🌐 EXTERNAL INTEGRATIONS
VITE_GITHUB_REPO_URL=https://github.com/intellitrace/intellitrace
VITE_TWITTER_URL=https://twitter.com/intellitrace
VITE_LINKEDIN_URL=https://linkedin.com/company/intellitrace
VITE_SLACK_COMMUNITY_URL=https://slack.intellitrace.ai

# 📱 DEVICE CONFIGURATION
VITE_SUPPORTED_BROWSERS=chrome,firefox,safari,edge
VITE_MINIMUM_BROWSER_VERSION_CHROME=90
VITE_MINIMUM_BROWSER_VERSION_FIREFOX=88
VITE_MINIMUM_BROWSER_VERSION_SAFARI=14

# 🎬 MEDIA & ASSETS
VITE_PUBLIC_ASSETS_PATH=/
VITE_ENABLE_LAZY_IMAGES=true
VITE_IMAGE_PLACEHOLDER_COLOR=#e0e0e0
VITE_MAX_IMAGE_DIMENSIONS=2048x2048

# 🔍 SEARCH & FILTERING
VITE_SEARCH_DEBOUNCE_DELAY=300
VITE_SEARCH_MIN_CHARACTERS=2
VITE_ADVANCED_FILTERS_ENABLED=true
VITE_SAVED_FILTERS_MAX=10

# 📊 CHART CONFIGURATION
VITE_CHART_ANIMATION=true
VITE_CHART_RESPONSIVE=true
VITE_CHART_TOOLTIP_TRIGGER=hover
VITE_CHART_DEFAULT_COLORS=#3b82f6,#ef4444,#10b981,#f59e0b

# 🎯 REPORTING
VITE_REPORT_FORMATS=pdf,csv,excel,json
VITE_REPORT_MAX_ROWS=10000
VITE_REPORT_RETENTION_DAYS=30
VITE_SCHEDULED_REPORTS_ENABLED=true

# 🌍 MAP & GEOLOCATION
VITE_MAPBOX_ACCESS_TOKEN=
VITE_ENABLE_LOCATION_FEATURES=true
VITE_DEFAULT_MAP_CENTER=[0,0]
VITE_DEFAULT_MAP_ZOOM=3

# 🚀 BUILD CONFIGURATION
VITE_SOURCEMAP=false
VITE_MINIFY=true
VITE_ANALYZE_BUNDLE=false

# 🔧 DEVELOPMENT
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_HMR=true
VITE_LOG_LEVEL=info

# 🏪 PRICING & MONETIZATION
VITE_SHOW_PRICING=true
VITE_FREE_TIER_ENABLED=true
VITE_TRIAL_DURATION_DAYS=14
VITE_PRICING_CURRENCY=USD
