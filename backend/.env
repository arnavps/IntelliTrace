# ===============================================================
# IntelliTrace Backend Environment Configuration
# ===============================================================

# 🔗 PRIMARY DATABASE - NEON (PostgreSQL-Compatible)
# Neon is a fully managed PostgreSQL service ideal for production
NEON_DATABASE_URL=postgresql://user:password@ep-silent-cloud-12345.us-east-1.neon.tech/intellitrace_db?sslmode=require
NEON_USER=user
NEON_PASSWORD=password
NEON_HOST=ep-silent-cloud-12345.us-east-1.neon.tech
NEON_PORT=5432
NEON_DBNAME=intellitrace_db

# 🔗 FALLBACK DATABASE - LOCAL POSTGRESQL (Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=intellitrace_admin
POSTGRES_PASSWORD=IntelliTraceSecureDB2026
POSTGRES_DB=intellitracedb

# 🗄️ DATABASE REPLICATION & CDC (Change Data Capture)
# For Debezium PostgreSQL CDC Connector
DEBEZIUM_DB_USER=debezium_cdc_user
DEBEZIUM_DB_PASSWORD=VaultDecryptedSecurePassword123!
DEBEZIUM_REPLICATION_SLOT=debezium_cbs_replica_slot
DEBEZIUM_PUBLICATION=dbz_cbs_publication
DEBEZIUM_SCHEMA_INCLUDE=cbs_ledger
DEBEZIUM_TABLE_INCLUDE=cbs_ledger.banking_ledger,cbs_ledger.account_balances

# 🌐 NEO4J GRAPH DATABASE
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=IntelliTraceGraph2026
NEO4J_SCHEME=bolt
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes
NEO4J_MEMORY_HEAP_INITIAL_SIZE=2G
NEO4J_MEMORY_HEAP_MAX_SIZE=4G
NEO4J_MEMORY_PAGECACHE_SIZE=2G

# 💾 REDIS CACHE & BLOOM FILTERS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_BLOOM_ENABLED=true

# 📊 KAFKA STREAMING PLATFORM
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKERS=kafka:29092
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_TOPIC_TRANSACTIONS=intellitrace-transactions
KAFKA_TOPIC_ALERTS=intellitrace-alerts
KAFKA_TOPIC_AUDIT=intellitrace-audit
KAFKA_CONSUMER_GROUP=intellitrace-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_SCHEMA_REGISTRY_HOST=schema-registry
KAFKA_SCHEMA_REGISTRY_PORT=8081

# 📡 SCHEMA REGISTRY (Confluent)
SCHEMA_REGISTRY_HOST=schema-registry
SCHEMA_REGISTRY_PORT=8081
SCHEMA_REGISTRY_URL=http://localhost:8081

# 🔌 ZOOKEEPER
ZOOKEEPER_HOST=zookeeper
ZOOKEEPER_PORT=2181

# 📈 PROMETHEUS MONITORING
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s

# 📊 GRAFANA VISUALIZATION
GRAFANA_HOST=localhost
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GrafanaSecurePassword2026
GRAFANA_PATHS_PROVISIONING=/etc/grafana/provisioning
GRAFANA_DEFAULT_THEME=dark

# 🚀 FASTAPI APPLICATION
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=true
FASTAPI_WORKERS=4
FASTAPI_ENVIRONMENT=development

# 🤖 APACHE FLINK STREAMING
FLINK_JOBMANAGER_HOST=localhost
FLINK_JOBMANAGER_PORT=8081
FLINK_TASKMANAGER_SLOTS=4
FLINK_STATE_BACKEND=rocksdb
FLINK_CHECKPOINT_MODE=EXACTLY_ONCE
FLINK_CHECKPOINT_INTERVAL=60000
FLINK_PARALLELISM=2

# 🔐 SECURITY & ENCRYPTION
SECRET_KEY=your-super-secret-key-change-this-in-production
API_KEY_LENGTH=32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENCRYPTION_ALGORITHM=AES-256-GCM
HASH_ALGORITHM=sha256

# 📝 PII SECURITY (DPDP Act 2023 Compliance)
PII_TOKENIZATION_ENABLED=true
TOKENIZATION_PEPPER_KEY=additional-secure-pepper-key
MAX_AADHAAR_ATTEMPTS=3
PAN_MASKING_FORMAT=****{last_4}

# 🎓 MACHINE LEARNING MODELS
MODEL_ANOMALY_DETECTOR_PATH=/var/models/anomaly_detector.pkl
MODEL_INSIDER_THREAT_PATH=/var/models/insider_threat_model.xgb
MODEL_PMLA_MAPPER_PATH=/var/models/pmla_mapper.pkl
MODEL_GNN_PATH=/var/models/gnn_model.pt
XGBOOST_MODEL_PATH=/var/log/intellitrace/xgboost_champion.model

# 📊 CONTINUOUS RETRAINING PIPELINE
TRAINING_DB_PATH=/var/log/intellitrace/human_feedback.jsonl
RETRAINING_BATCH_SIZE=1000
RETRAINING_ENABLED=true
MODEL_VALIDATION_AUC_THRESHOLD=0.85
MODEL_FALSE_POSITIVE_TARGET=0.05

# 🌍 TRANSACTION PARSING
SUPPORTED_CHANNELS=UPI,SWIFT,NEFT,RTGS,IMPS,Cards,Wallets,ACH,ATM
ISO20022_ENABLED=true
ISO8583_ENABLED=true
UPI_ENABLED=true

# 📋 AUDIT & LOGGING
AUDIT_LOG_LEVEL=INFO
AUDIT_LOG_FILE=/var/log/intellitrace/audit.log
APPLICATION_LOG_LEVEL=INFO
APPLICATION_LOG_FILE=/var/log/intellitrace/app.log
LOG_FORMAT=json
LOG_RETENTION_DAYS=90

# 🔍 ANOMALY DETECTION
ANOMALY_DETECTION_THRESHOLD=0.7
ANOMALY_MIN_SAMPLES=100
ANOMALY_CONTAMINATION=0.1
DRIFT_DETECTION_ENABLED=true
DRIFT_DETECTION_WINDOW=30

# 🕵️ INSIDER THREAT DETECTION
INSIDER_THREAT_ENABLED=true
INSIDER_THREAT_SENSITIVITY=0.8
INSIDER_THREAT_MIN_TRANSACTIONS=50

# 📡 NARRATIVE GENERATION
NARRATIVE_GENERATION_ENABLED=true
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
NARRATIVE_MAX_LENGTH=500
NARRATIVE_LANGUAGE=en

# 💰 ROUND TRIPPING DETECTION
ROUND_TRIPPING_ENABLED=true
ROUND_TRIPPING_VELOCITY_THRESHOLD=0.85
ROUND_TRIPPING_TIME_WINDOW=3600

# 🏦 SHADOW ROUTING DETECTION
SHADOW_ROUTING_ENABLED=true
SHADOW_ROUTING_THRESHOLD=0.75
SHADOW_ROUTING_MIN_HOPS=3

# 🔗 ENTITY RESOLUTION
ENTITY_RESOLUTION_ENABLED=true
ENTITY_RESOLUTION_THRESHOLD=0.9
ENTITY_RESOLUTION_MAX_MATCHES=10

# 🛡️ GUARD POLICIES
GUARD_ENFORCEMENT_LEVEL=strict
GUARD_FALLBACK_BEHAVIOR=reject
GUARD_LOG_VIOLATIONS=true

# 🌐 CORS CONFIGURATION
CORS_ORIGINS=*
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*
CORS_MAX_AGE=3600

# 📱 API VERSIONING
API_VERSION=v1
API_PREFIX=/api/v1

# 🧪 TESTING CONFIGURATION
TESTING_ENABLED=false
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/intellitrace_test
TESTCONTAINERS_RYUK_DISABLED=false

# 🔧 DEVELOPMENT CONFIGURATION
DEBUG_MODE=false
VERBOSE_LOGGING=false
STACKTRACE_ON_ERROR=true

# 📦 EXTERNAL SERVICES
EXTERNAL_SERVICE_TIMEOUT=30
EXTERNAL_SERVICE_RETRIES=3
EXTERNAL_SERVICE_BACKOFF_MULTIPLIER=2

# 🌍 LOCALIZATION & CURRENCY
DEFAULT_CURRENCY=INR
SUPPORTED_CURRENCIES=USD,EUR,GBP,INR,AUD,CAD,SGD,HKD
EXCHANGE_RATE_API_KEY=xxxxxxxxxxxxx
EXCHANGE_RATE_UPDATE_INTERVAL=3600

# 📊 PERFORMANCE TUNING
BATCH_PROCESSING_SIZE=1000
CACHE_TTL_SECONDS=3600
CONNECTION_POOL_SIZE=20
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# 🚀 DEPLOYMENT ENVIRONMENT
ENVIRONMENT=development
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_ZONE=zone-1
REPLICA_COUNT=1

# 🔔 ALERTING & NOTIFICATIONS
ALERT_SEVERITY_THRESHOLD=MEDIUM
ALERT_RETENTION_DAYS=30
NOTIFICATION_CHANNELS=email,webhook
EMAIL_FROM=noreply@intellitrace.ai
WEBHOOK_URL=https://your-webhook-endpoint.com/alerts

# 🛠️ MAINTENANCE & HEALTH CHECKS
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
READINESS_PROBE_DELAY=10
LIVENESS_PROBE_DELAY=30

# 📚 DOCUMENTATION
API_DOCUMENTATION_URL=/docs
API_OPENAPI_URL=/openapi.json
REDOC_URL=/redoc

# 🎯 FEATURE FLAGS
FEATURE_ANOMALY_DETECTION=true
FEATURE_INSIDER_THREAT=true
FEATURE_PMLA_DETECTION=true
FEATURE_NARRATIVE_GENERATION=true
FEATURE_CONTINUOUS_LEARNING=true
FEATURE_GRAPH_ANALYTICS=true
